{
  "name": "playground-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3100 --strictPort",
    "build": "tsc --noEmit && vite build && node tools/build-prototypes.mjs",
    "test:prototype": "node prototype/tests/sim_test.js",
    "preview": "vite preview --host 0.0.0.0 --port 3100 --strictPort",
    "test": "node --experimental-strip-types --test src/games/engine.test.ts src/games/quiz.test.ts src/games/race/engine.test.ts src/games/defense/engine.test.ts src/games/defense/campaign.test.ts src/games/defense/difficulty.test.ts src/lib/storage.test.ts src/games/defense/tactics.test.ts src/components/defenseInput.test.ts",
    "models:build": "blender -b --python tools/blender/build_towers.py",
    "balance:defense": "node --experimental-strip-types tools/balance-defense.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
