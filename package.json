{
  "name": "playground-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3100 --strictPort",
    "build": "tsc --noEmit && vite build && node tools/build-prototypes.mjs",
    "test:prototype": "node prototype/tests/sim_test.js",
    "preview": "vite preview --host 0.0.0.0 --port 3100 --strictPort",
    "test": "node --experimental-strip-types --test src/games/engine.test.ts src/games/quiz.test.ts src/games/race/engine.test.ts src/games/defense/engine.test.ts src/games/defense/campaign.test.ts src/games/defense/difficulty.test.ts src/lib/storage.test.ts src/lib/haptic.test.ts src/games/defense/tactics.test.ts src/components/defenseInput.test.ts src/components/defenseFrame.test.ts src/components/defenseSound.test.ts src/games/defense/themes.test.ts src/games/defense/fieldGuide.test.ts src/games/defense/art.test.ts src/games/defense/locomotion.test.ts src/games/defense/action.test.ts src/games/defense/terrain.test.ts src/games/defense/gateAssets.test.ts src/games/defense/gateImpact.test.ts",
    "art:gates": "node tools/build-defense-gates.mjs",
    "art:themes": "node tools/build-defense-themes.mjs",
    "models:build": "blender -b --python tools/blender/build_towers.py && npm run models:sprites",
    "balance:defense": "node --experimental-strip-types tools/balance-defense.ts",
    "models:sprites": "node tools/build-tower-sprites.mjs",
    "art:atlases": "node tools/build-motion-atlases.mjs",
    "models:dwarf": "blender -b --python tools/blender/build_dwarf.py && npm run models:hero-sprites",
    "models:hero-sprites": "node tools/build-hero-sprites.mjs",
    "models:slime": "blender -b --python tools/blender/build_slime.py",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "models:water-action-lv3": "blender --python-exit-code 1 -b --python tools/blender/build_water_cannon_action.py -- --level 3",
    "models:water-action": "blender --python-exit-code 1 -b --python tools/blender/build_water_cannon_action.py",
    "models:dwarf-directions": "blender -b --python tools/blender/build_dwarf_directions.py",
    "models:dwarf-walk": "blender -b --python tools/blender/build_dwarf_walk.py && node tools/build-hero-sprites.mjs --walk",
    "models:wolf": "blender -b --python tools/blender/build_wolf.py",
    "models:wood": "blender --python-exit-code 1 -b --python tools/blender/build_wood.py --",
    "models:bridge": "node --experimental-strip-types tools/export-terrain-layout.ts && blender --python-exit-code 1 -b --python tools/blender/build_terrain.py -- --bridge",
    "models:terrain": "node --experimental-strip-types tools/export-terrain-layout.ts && blender -b --python tools/blender/build_terrain.py",
    "models:wolf-collapse": "blender --python-exit-code 1 -b --python tools/blender/build_wolf_collapse.py",
    "models:forest-gate": "blender --python-exit-code 1 -b --python tools/blender/build_forest_gate.py",
    "models:forest-gate-impact": "blender --python-exit-code 1 -b --python tools/blender/build_forest_gate_impact.py",
    "models:dwarf-locomotion": "blender --python-exit-code 1 -b --python tools/blender/build_dwarf_locomotion.py",
    "models:ballista-action": "blender --python-exit-code 1 -b --python tools/blender/build_ballista_action.py --",
    "models:ballista-action-lv3": "blender --python-exit-code 1 -b --python tools/blender/build_ballista_action.py -- --level 3",
    "models:dwarf-hammer": "blender --python-exit-code 1 -b --python tools/blender/build_dwarf_hammer.py --",
    "models:mage": "blender --python-exit-code 1 -b --python tools/blender/build_mage.py --",
    "models:elf": "blender --python-exit-code 1 -b --python tools/blender/build_elf.py --",
    "models:tao": "blender --python-exit-code 1 -b --python tools/blender/build_tao.py --",
    "models:druid": "blender --python-exit-code 1 -b --python tools/blender/build_druid.py --",
    "models:pet-wolf": "blender --python-exit-code 1 -b --python tools/blender/build_pet_wolf.py --",
    "models:fire-action": "blender --python-exit-code 1 -b --python tools/blender/build_fire_tower_action.py --",
    "models:fire-action-lv3": "blender --python-exit-code 1 -b --python tools/blender/build_fire_tower_action.py -- --level 3",
    "models:barbarian": "blender --python-exit-code 1 -b --python tools/blender/build_barbarian.py --"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
