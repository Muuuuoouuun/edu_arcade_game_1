diff --git a/src/rush/webgpu-spike.ts b/src/rush/webgpu-spike.ts
new file mode 100644
index 0000000..ab61679
--- /dev/null
+++ b/src/rush/webgpu-spike.ts
@@ -0,0 +1,15 @@
+// Cycle 07 spike: an opt-in WebGPURenderer path (?renderer=webgpu[&forcewebgl]). Lazily loaded, so the default
+// WebGL build never ships three/webgpu. Our toon rim and ink outlines patch GLSL via onBeforeCompile, which node
+// materials ignore — see docs/rush/cycles/07-spike.md for what that changes on screen.
+import type { RenderBackend } from './render.ts';
+
+export type SpikeRenderer = { renderer: RenderBackend; backend: 'webgpu' | 'webgl2'; initMs: number };
+
+export async function createWebGPURenderer(canvas: HTMLCanvasElement, forceWebGL: boolean): Promise<SpikeRenderer> {
+  const t0 = performance.now();
+  const { WebGPURenderer } = await import('three/webgpu');
+  const renderer = new WebGPURenderer({ canvas, antialias: devicePixelRatio < 2, forceWebGL });
+  await renderer.init();
+  const backend = (renderer.backend as { isWebGPUBackend?: boolean }).isWebGPUBackend ? 'webgpu' : 'webgl2';
+  return { renderer: renderer as unknown as RenderBackend, backend, initMs: Math.round(performance.now() - t0) };
+}
