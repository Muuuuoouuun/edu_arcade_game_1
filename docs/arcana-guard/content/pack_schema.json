{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arcana Guard Content Pack",
  "description": "아르카나 수비대 콘텐츠 팩. 4지선다(mc), 참/거짓(tf), 짧은 입력(input), 순서 배열(order)을 표현한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "grade_band", "version", "locale", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,39}$", "description": "팩 고유 ID" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "subject": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$", "description": "예: math, english, science, history" },
    "grade_band": { "type": "string", "enum": ["g5-6", "g7-8", "g5-8"] },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "description": "semver" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "UI/해설 언어. 예: ko-KR" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/item" },
      "description": "item.id 는 팩 안에서 유일해야 한다(스키마로 표현 불가 -> 로더/검증 스크립트가 확인)."
    }
  },
  "definitions": {
    "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_:-]{0,39}$", "description": "topic:*, skill:*, misconception:* 접두 규칙 권장" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "answer", "difficulty", "tags", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,39}$" },
        "type": { "type": "string", "enum": ["mc", "tf", "input", "order"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": "mc: 보기 4개 / order: 배열할 항목(화면에는 섞어서 표시) / tf, input: 사용 금지"
        },
        "input_kind": {
          "type": "string",
          "enum": ["number", "fraction", "word"],
          "description": "input 전용. 키패드 종류 결정. word 는 영문 소문자(a-z) 철자만."
        },
        "answer": {
          "type": ["integer", "boolean", "array"],
          "items": { "type": ["string", "integer"] },
          "description": "mc: 정답 보기 인덱스(0~3) / tf: true|false / input: 허용 정답 문자열 배열 / order: choices 인덱스를 올바른 순서로 나열한 배열"
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/tag" }
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 120, "description": "1문장 해설" },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src", "alt"],
          "properties": {
            "kind": { "type": "string", "enum": ["image", "audio"] },
            "src": { "type": "string", "minLength": 1, "maxLength": 200 },
            "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mc" } }, "required": ["type"] },
          "then": {
            "required": ["choices"],
            "not": { "required": ["input_kind"] },
            "properties": {
              "choices": { "minItems": 4, "maxItems": 4 },
              "answer": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tf" } }, "required": ["type"] },
          "then": {
            "allOf": [
              { "not": { "required": ["choices"] } },
              { "not": { "required": ["input_kind"] } }
            ],
            "properties": { "answer": { "type": "boolean" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "input" } }, "required": ["type"] },
          "then": {
            "required": ["input_kind"],
            "not": { "required": ["choices"] },
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 40 }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "order" } }, "required": ["type"] },
          "then": {
            "required": ["choices"],
            "not": { "required": ["input_kind"] },
            "properties": {
              "choices": { "minItems": 3, "maxItems": 6 },
              "answer": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 0, "maximum": 5 }
              }
            }
          }
        }
      ]
    }
  }
}
