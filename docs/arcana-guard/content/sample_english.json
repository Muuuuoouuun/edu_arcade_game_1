    { "id": "e-011", "type": "input", "input_kind": "word", "prompt": "'아름다운'을 뜻하는 영어 단어를 쓰세요. (b로 시작)", "answer": ["beautiful"], "difficulty": 2, "tags": ["topic:adjective", "skill:spelling"], "explanation": "'아름다운'은 beautiful이며 beauty에서 온 말이에요." },
