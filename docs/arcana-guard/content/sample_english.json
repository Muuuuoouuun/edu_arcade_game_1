    { "id": "e-017", "type": "tf", "prompt": "achieve는 '이루다, 달성하다'라는 뜻이다.", "answer": true, "difficulty": 3, "tags": ["topic:verb", "skill:meaning"], "explanation": "achieve는 목표를 '이루다, 달성하다'라는 뜻이에요." },
    { "id": "e-018", "type": "mc", "prompt": "빈칸에 알맞은 말은? She was ___ to hear the good news. (기쁜)", "choices": ["delighted", "delayed", "deleted", "delivered"], "answer": 0, "difficulty": 3, "tags": ["topic:feeling", "skill:context"], "explanation": "좋은 소식을 듣고 '매우 기뻐한'이라는 뜻의 delighted가 알맞아요." },
    { "id": "e-019", "type": "input", "input_kind": "word", "prompt": "'편안한'을 영어로 쓰세요.", "answer": ["comfortable"], "difficulty": 3, "tags": ["topic:adjective", "skill:spelling"], "explanation": "'편안한'은 comfortable이며 comfort에 -able이 붙은 말이에요." },
