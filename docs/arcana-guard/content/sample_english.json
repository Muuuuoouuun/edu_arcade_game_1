    { "id": "e-013", "type": "input", "input_kind": "word", "prompt": "'날씨'를 영어로 쓰세요.", "answer": ["weather"], "difficulty": 2, "tags": ["topic:nature", "skill:spelling"], "explanation": "'날씨'는 weather이며 ea 철자에 주의해요." },
